# Kopieren nach .env im Repo-Root (lokal) bzw. auf dem VPS neben docker-compose.yml.
# .env selbst ist in .gitignore und wird nie committet.

DB_NAME=almo
DB_USER=almo
DB_PASSWORD=change-me

BACKEND_PORT=8094
FRONTEND_PORT=8093

# Nur lokal auf false setzen (kein TLS ohne nginx davor) - auf dem VPS unverändert
# lassen/weglassen, Default ist true.
# COOKIE_SECURE=false

# Origin des Frontends, auf das der Passwort-Reset-Link zeigt (nicht die API).
FRONTEND_URL=http://localhost:8093

BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@almo-group.vn-nspace.de
BREVO_SENDER_NAME=Almo Schmuck

# Wohin neue Bestellungen gemeldet werden, und was dem Kunden auf dem Bestell-PDF als
# Kontaktweg gezeigt wird, falls sich der Admin nicht meldet. Platzhalter - echte Werte
# eintragen, sobald sie feststehen (siehe Sprint-4-Entscheidung in docs/backlog.md).
ADMIN_EMAIL=orders@almo-group.vn-nspace.de
ADMIN_WHATSAPP=+49 000 0000000

# Leer lassen = Bild-Upload liefert einen klaren "nicht konfiguriert"-Fehler statt zu crashen
# (siehe Sprint-5-Entscheidung in docs/backlog.md) - Format zum Eintragen:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
