# Kopieren nach .env im Repo-Root (lokal) bzw. auf dem VPS neben docker-compose.yml.
# .env selbst ist in .gitignore und wird nie committet.

DB_NAME=almo
DB_USER=almo
DB_PASSWORD=change-me

BACKEND_PORT=8094
FRONTEND_PORT=8093

# Nur lokal auf false setzen (kein TLS ohne nginx davor) - auf dem VPS unverändert
# lassen/weglassen, Default ist true.
# COOKIE_SECURE=false

# Origin des Frontends, auf das der Passwort-Reset-Link zeigt (nicht die API).
FRONTEND_URL=http://localhost:8093

BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@almo-group.vn-nspace.de
BREVO_SENDER_NAME=Almo Schmuck

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
