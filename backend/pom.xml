<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>de.almo</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Almo Shop Backend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- Overrides spring-boot-dependencies 4.1.1's own managed tomcat.version (11.0.24), which
		     Trivy flags with 3 CRITICAL CVEs (2026-65182, 2026-65905, 2026-68525) fixed in 11.0.25 -
		     Spring Boot itself hasn't picked up the patched Tomcat yet as of 4.1.1. Check
		     https://mvnrepository.com/artifact/org.apache.tomcat.embed/tomcat-embed-core for a newer
		     fix once Spring Boot's own dependency management catches up, then this override can go. -->
		<tomcat.version>11.0.25</tomcat.version>
		<!-- Not covered by spring-boot-starter-parent's own dependency management - pinned here
		     directly. Check https://github.com/testcontainers/testcontainers-java/releases before
		     bumping. -->
		<testcontainers.version>1.21.3</testcontainers.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- Health/readiness endpoints; also what docker-compose and the deploy
		     script poll to know the container is actually up, not just started. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Backs Spring Session below, not used directly as an app-level cache yet. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Stores the login session in Redis instead of backend memory, so users
		     stay logged in across a container restart/redeploy (see spec). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- optional=true keeps Lombok out of the transitive dependency tree of
		     anything that depends on this module later (it's a compile-time-only tool). -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Argon2PasswordEncoder (see SecurityConfig) delegates to Bouncy Castle for the actual
		     Argon2 algorithm - it's not bundled in spring-security-crypto itself, so without this
		     the app throws NoClassDefFoundError the first time a password is hashed. Version isn't
		     Spring-Boot-managed (not in its BOM), pinned here directly - check
		     https://mvnrepository.com/artifact/org.bouncycastle/bcprov-jdk18on before bumping.
		     1.86 (latest per Maven Central metadata, checked 2026-09-12) - 1.80 was flagged by
		     Trivy for CVE-2025-14813 (GOSTCTR block-count overflow), fixed in 1.80.2+. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.86</version>
		</dependency>
		<!-- Order-confirmation PDF (Sprint 4). LGPL/MPL-dual-licensed, package renamed to
		     org.openpdf as of 3.0.0 (was com.lowagie before) - check
		     https://github.com/LibrePDF/OpenPDF/releases before bumping across a major version. -->
		<dependency>
			<groupId>com.github.librepdf</groupId>
			<artifactId>openpdf</artifactId>
			<version>3.0.5</version>
		</dependency>
		<!-- Product image upload (Sprint 5). cloudinary-http5 is the current SDK line (Apache
		     HttpClient 5) - cloudinary-http45 is the older, now largely superseded HttpClient-4.4
		     line, still updated but capped around 1.39.0; verified via Maven Central metadata, not
		     the (slightly stale) README, before picking this artifact. -->
		<dependency>
			<groupId>com.cloudinary</groupId>
			<artifactId>cloudinary-http5</artifactId>
			<version>2.4.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers: real Postgres + Redis in CI/local test runs instead of mocking JdbcClient/
		     JPA away - see Sprint 6 decision in docs/backlog.md. spring-boot-testcontainers wires up
		     @ServiceConnection so container connection details flow into Spring's datasource/redis
		     config automatically, no manual @DynamicPropertySource needed. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Enforces consistent formatting in CI (see .github/workflows/ci.yml).
			     Run `./mvnw spotless:apply` locally before committing to auto-fix;
			     `verify` phase means `mvn install`/CI fails on unformatted code, but
			     plain `mvn compile` still works for fast local iteration. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<!-- 2.44.x's bundled google-java-format breaks on JDK 25 (javac
				     internals changed a method's return type: NoSuchMethodError on
				     DeferredDiagnosticHandler.getDiagnostics). 3.10+ picks
				     google-java-format 1.30.0 automatically on JVM 25+, which fixes it. -->
				<version>3.10.2</version>
				<configuration>
					<java>
						<googleJavaFormat/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
